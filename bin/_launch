#!/usr/bin/env bash
set -euo pipefail

MODULE="$1"
shift

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

resolve_python() {
  if [ -n "${BTL_PYTHON:-}" ] && [ -x "${BTL_PYTHON}" ]; then
    printf '%s\n' "$BTL_PYTHON"
    return
  fi
  for venv_py in "$REPO_ROOT/.venv/bin/python3" "$REPO_ROOT/api/.venv/bin/python3"; do
    if [ -x "$venv_py" ]; then
      printf '%s\n' "$venv_py"
      return
    fi
  done
  if command -v pyenv >/dev/null 2>&1; then
    local pyenv_py
    if pyenv_py="$(cd "$REPO_ROOT" && pyenv which python3 2>/dev/null)" && [ -x "$pyenv_py" ]; then
      printf '%s\n' "$pyenv_py"
      return
    fi
  fi
  command -v python3
}

PYTHON_BIN="$(resolve_python)"
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m "$MODULE" "$@"
